// Cloudflare Worker + static assets of the public site (ADR 0006). Deploy: CI workflow `site`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tatamap",
  "main": "edge/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // No SPA fallback here: it would also answer missing static files with index.html. The Worker
    // serves index.html for unknown navigations instead (edge/worker.ts).
    "not_found_handling": "none",
    // The Worker only sees HTML navigations: every static file bypasses it (free and unlimited).
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/data/*",
      "!/models/*",
      "!/ads.txt",
      "!/robots.txt",
      "!/favicon.svg",
      "!/apple-touch-icon.png"
    ]
  },
  // CSP violation reports (POST /csp-report) are logged by the Worker with console.log.
  "observability": { "enabled": true },
  // Served on tatamap.fr only (zone on Cloudflare, ADR 0006 D5). Deploying it needs the token's
  // "Workers Routes: Edit" on that zone. No workers.dev address and no preview URLs: one public origin.
  // www.tatamap.fr is redirected to the apex by a zone redirect rule, not by this Worker.
  "routes": [{ "pattern": "tatamap.fr", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // Fail closed: unknown profile = strict, enforced unless CSP_REPORT_ONLY is exactly "true".
    // The site workflow overrides CSP_PROFILE with 'strict' when VITE_ADSENSE_CLIENT is empty.
    // Report-only for the first two weeks (ADR 0006 D5), then set to "false".
    "CSP_PROFILE": "adsense",
    "CSP_REPORT_ONLY": "true"
  }
}
