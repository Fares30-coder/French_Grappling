// Cloudflare Worker + static assets of the public site (ADR 0006). Deploy: CI workflow `site`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tatamap",
  "main": "edge/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker only sees HTML navigations: every static file bypasses it (free and unlimited).
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/data/*",
      "!/models/*",
      "!/ads.txt",
      "!/favicon.svg",
      "!/apple-touch-icon.png"
    ]
  },
  "vars": {
    // 'strict' = no ads. Report-only for the first two weeks (ADR 0006 D5), then set to "false".
    "CSP_PROFILE": "adsense",
    "CSP_REPORT_ONLY": "true"
  }
}
