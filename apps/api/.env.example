# Database used by `pnpm test` (never the dev one). Create it with
# `docker compose exec db createdb -U tatamap tatamap_test`, then `pnpm db:test:reset`.
TEST_DATABASE_URL=postgresql://tatamap:tatamap@localhost:5432/tatamap_test
