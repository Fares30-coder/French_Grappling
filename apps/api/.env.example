NODE_ENV=development
DATABASE_URL=postgresql://tatamap:tatamap@localhost:5432/tatamap
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
# Database used by `pnpm test` (never the dev one). Create it with
# `docker compose exec db createdb -U tatamap tatamap_test`, then `pnpm db:test:reset`.
TEST_DATABASE_URL=postgresql://tatamap:tatamap@localhost:5432/tatamap_test
# Required, at least 32 bytes. The API refuses to start while it is empty.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
# Comma-separated list of front origins allowed to send unsafe requests (use localhost, not 127.0.0.1).
WEB_ORIGINS=http://localhost:5173
# Keep true. Set to false only if your browser refuses Secure cookies on http://localhost (Safari).
# The API refuses to start with false when NODE_ENV=production.
COOKIE_SECURE=true
# Number of reverse proxies in front of the API (0 locally). In production the number of hops
# depends on the hosting (a front-end rewrite plus the API host is often 2 or more): measure it at
# deployment (phase 3) from the X-Forwarded-For the API receives. Too low rate-limits the proxy's
# address for everyone; too high lets a client forge its IP. Never expose the API port directly.
TRUST_PROXY=0
# If port 5432 is already used on your machine, put DB_PORT=5433 in a root .env
# (read by docker compose, gitignored) and use port 5433 in DATABASE_URL above.
# Folder of the exported content (`pnpm content:export` / `content:import`): a clone of the private
# repo Fares30-coder/tatamap-content. Default: content/ at the repo root; relative paths start there.
# CONTENT_DIR=content
