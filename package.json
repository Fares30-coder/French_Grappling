{
  "name": "tatamap",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tatamap/api --filter @tatamap/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @tatamap/api exec prisma generate",
    "db:migrate": "pnpm --filter @tatamap/api exec prisma migrate dev",
    "db:reset": "pnpm --filter @tatamap/api exec prisma migrate reset --force",
    "db:seed": "pnpm --filter @tatamap/api exec prisma db seed"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.6.3"
  }
}
