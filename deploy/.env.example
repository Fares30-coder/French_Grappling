# Production environment of the VPS: copy to /opt/tatamap/.env (owner deploy, chmod 600).
# Names only: never commit real values. See docs/adr/0005-hebergement.md D6.
NODE_ENV=production
GHCR_OWNER=
SITE_DOMAIN=
ACME_EMAIL=
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
WEB_ORIGINS=
COOKIE_SECURE=true
TRUST_PROXY=1
LOG_LEVEL=info
# adsense (default, AdSense at launch) or strict (no ads). A change needs a new web build.
CSP_PROFILE=adsense
# Content-Security-Policy-Report-Only for the first two weeks, then Content-Security-Policy.
CSP_HEADER=Content-Security-Policy-Report-Only
# on until the security audit is done, then off.
PRELAUNCH=on
PRELAUNCH_USER=
PRELAUNCH_HASH=
# Written by scripts/deploy.sh: digests (sha256:...) of the running images.
WEB_DIGEST=
API_DIGEST=
TOOLS_DIGEST=
